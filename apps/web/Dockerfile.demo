FROM node:22-alpine AS build

WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json ./
COPY src src
COPY public public
ARG VITE_USE_API=true
ARG VITE_ORGANIZATION_CODE=SIMTIM
ARG VITE_STORE_CODE=MAIN
ENV VITE_USE_API=$VITE_USE_API \
    VITE_ORGANIZATION_CODE=$VITE_ORGANIZATION_CODE \
    VITE_STORE_CODE=$VITE_STORE_CODE
RUN npm run build

FROM nginx:stable-alpine

COPY nginx.demo.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
