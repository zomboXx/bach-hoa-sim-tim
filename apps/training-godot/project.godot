; Chapter 0: the simulation is a real Godot Web build, separate from the PWA.
config_version=5

[application]
config/name="Sim Tím · Ngày đầu tiên"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=620
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.09, 0.08, 0.15, 1)

[audio]
driver/enable_input=false
